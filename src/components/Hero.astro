<section class="hero" id="home">
  <video
    autoplay
    muted
    playsinline
    preload="auto"
    poster="/images/img1.jpeg"
    fetchpriority="high"
    class="hero__video"
    id="hero-video"
  >
    <source src="/videos/IMG_2499.mp4" type="video/mp4" />
  </video>

  <video muted preload="auto" class="hero__video hero__video--next" id="hero-video-next"></video>

  <div class="hero__overlay"></div>

  <div class="hero__content">
    <div class="hero__top">
      <div class="hero__welcome hero-anim">Welcome to</div>

      <img src="/images/logo.png" alt="Menma" class="hero__logo hero-anim" width="80" height="80" />

      <h1 class="hero__title hero-anim">MENMA</h1>

      <p class="hero__subtitle hero-anim">Catering &amp; Events</p>

      <div class="hero__divider hero-anim">
        <span class="hero__divider-line"></span>
        <span class="hero__divider-diamond">&#9670;</span>
        <span class="hero__divider-line"></span>
      </div>

      <p class="hero__tagline hero-anim">&ldquo;Life is an event. Make it memorable.&rdquo;</p>
    </div>

    <div class="hero__ctas hero-anim">
      <a href="#services" class="hero__cta hero__cta--outline">Explore Our Services</a>
      <a href="#contact" class="hero__cta hero__cta--solid">Book a Consultation</a>
    </div>
  </div>

</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const playlist = [
      '/videos/IMG_2499.mp4',
      '/videos/IMG_2506.mp4',
      '/videos/IMG_2508.mp4',
      '/videos/IMG_2618.mp4',
      '/videos/IMG_2621.mp4',
      '/videos/IMG_3519.mp4',
      '/videos/IMG_3626.mp4',
      '/videos/hero.mp4',
    ];

    const v1 = document.getElementById('hero-video');
    const v2 = document.getElementById('hero-video-next');
    const SEGMENT = 10;
    let current = 0;
    let active = v1;
    let buffer = v2;
    let busy = false;

    function preload(idx) {
      buffer.src = playlist[(current + 1) % playlist.length];
      buffer.load();
    }

    function advance() {
      if (busy) return;
      busy = true;

      const nextIdx = (current + 1) % playlist.length;
      buffer.src = playlist[nextIdx];
      buffer.load();

      const onCanPlay = () => {
        buffer.removeEventListener('canplaythrough', onCanPlay);

        active.style.opacity = '0';
        buffer.style.opacity = '1';

        buffer.currentTime = 0;
        buffer.play();

        const tmp = active;
        active = buffer;
        buffer = tmp;

        current = nextIdx;
        active.style.pointerEvents = 'auto';
        buffer.style.pointerEvents = 'none';

        preload(current);

        setTimeout(() => { busy = false; }, 600);
      };

      if (buffer.readyState >= 3) {
        onCanPlay();
      } else {
        buffer.addEventListener('canplaythrough', onCanPlay, { once: true });
      }
    }

    preload(0);

    active.addEventListener('timeupdate', () => {
      if (active.currentTime >= SEGMENT && !busy) {
        advance();
      }
    });

    active.addEventListener('ended', advance);
  });
</script>

