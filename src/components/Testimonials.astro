---
const testimonials = [
  {
    quote: 'Menma turned our wedding into a fairy tale. Every detail was perfection — from the stage décor to the catering. Our guests are still talking about it!',
    name: 'Anjali &amp; Rohit',
    location: 'Palakkad, Kerala',
  },
  {
    quote: 'We entrusted Menma with our daughter&rsquo;s engagement and they exceeded every expectation. The team is creative, professional, and truly passionate.',
    name: 'Sreelakshmi Nair',
    location: 'Thrissur, Kerala',
  },
  {
    quote: 'The most seamless event planning experience. From Haldi to reception, Menma handled everything flawlessly. Highly recommend their services!',
    name: 'Faisal &amp; Family',
    location: 'Kozhikode, Kerala',
  },
];
---

<section class="testimonials section-padding" id="testimonials">
  <div class="container">
    <div class="testimonials__header reveal">
      <h2 class="section-heading" style="text-align: center;">What Our Clients Say</h2>
      <div class="gold-line" style="margin: 1rem auto 0;"></div>
    </div>

    <div class="testimonials__grid">
      {testimonials.map((t, i) => (
        <article class="testimonial-card reveal" style={`--delay: ${i * 0.15}s`}>
          <div class="testimonial-card__quote-mark">&ldquo;</div>
          <blockquote class="testimonial-card__text">{t.quote}</blockquote>
          <div class="testimonial-card__stars" aria-label="5 stars">
            <span>&#9733;</span><span>&#9733;</span><span>&#9733;</span><span>&#9733;</span><span>&#9733;</span>
          </div>
          <div class="testimonial-card__author">
            <strong>{t.name}</strong>
            <span class="testimonial-card__location">{t.location}</span>
          </div>
          <div class="testimonial-card__line"></div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials {
    background: white;
  }

  .testimonials__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .testimonials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .testimonial-card {
    background: var(--cream);
    padding: 2rem;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease var(--delay, 0s), transform 0.7s ease var(--delay, 0s), box-shadow 0.3s ease;
  }

  .testimonial-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .testimonial-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(212, 175, 55, 0.15);
  }

  .testimonial-card__quote-mark {
    font-family: var(--font-display);
    font-size: 4rem;
    line-height: 0.6;
    color: var(--gold);
    margin-bottom: 0.5rem;
  }

  .testimonial-card__text {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: 400;
    font-size: 0.95rem;
    color: var(--text-dark);
    line-height: 1.7;
    opacity: 0.85;
    margin-bottom: 1.25rem;
  }

  .testimonial-card__stars {
    display: flex;
    gap: 4px;
    color: var(--gold);
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }

  .testimonial-card__author {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--text-dark);
  }

  .testimonial-card__location {
    font-size: 0.8rem;
    font-weight: 300;
    opacity: 0.7;
  }

  .testimonial-card__line {
    width: 40px;
    height: 1px;
    background: var(--gold);
    margin-top: 1rem;
  }

  @media (min-width: 768px) {
    .testimonials__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }
</style>
